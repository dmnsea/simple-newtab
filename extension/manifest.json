{
  "manifest_version": 3,
  "name": "SimpleNewTab",
  "short_name": "NewTab",
  "description": "Custom new tab page for Chromium browsers",
  "developer": {
    "name": "dmnsea",
    "url": "https://github.com/dmnsea"
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version": "1.0.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Simple New Tab"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}